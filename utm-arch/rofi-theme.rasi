/* rofi in the utm-arch VM, installed by Home Manager (utm-home.nix) as
 * ~/.config/rofi/house.rasi. The house style of the assistant repo (I23): a white
 * card with a black border, a linen input row, one rust accent for the selected
 * row, HN for the labels and RobotoMono for the commands. Fonts scale by rofi's dpi
 * (192, in config.rasi); px sizes do not, so they are given at 2x. The border is
 * palette.nix's one width (borderPx, real pixels). utm-arch wiki/utm-theme.md. */

* {
    /* from utm-arch/palette.nix, filled in by utm-home.nix */
    linen:  @linen@;
    white:  @white@;
    ink:    @ink@;
    rust:   @rust@;
    dim:    @dim@;

    background-color: transparent;
    text-color:       @ink;
    font:             "HN Medium 11";
}

window {
    width:            1120px;
    location:         center;
    anchor:           center;
    y-offset:         -160px;
    background-color: @white;
    border:           @border_px@px;
    border-color:     @ink;
    padding:          0;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  0;
}

inputbar {
    children:         [ prompt, entry ];
    background-color: @linen;
    border:           0 0 @border_px@px 0;
    border-color:     @ink;
    padding:          20px 24px;
    spacing:          24px;
}

prompt {
    background-color: @ink;
    text-color:       @linen;
    font:             "HN Bold 8";
    padding:          6px 14px;
    vertical-align:   0.5;
}

entry {
    font:              "RobotoMono Nerd Font 11";
    placeholder:       "";
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    lines:     8;
    columns:   1;
    fixed-height: false;
    scrollbar: false;
    padding:   12px 0;
    spacing:   0;
}

element {
    padding: 12px 28px;
}

element-text {
    font:           "RobotoMono Nerd Font 10.5";
    vertical-align: 0.5;
}

element selected.normal, element selected.active {
    background-color: @rust;
}

element-text selected {
    text-color: @white;
}

element normal.urgent, element alternate.urgent {
    text-color: @rust;
}

message {
    background-color: @linen;
    border:           @border_px@px 0 0 0;
    border-color:     @ink;
    padding:          16px 24px;
}
