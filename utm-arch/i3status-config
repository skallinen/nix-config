# i3status for the utm-arch VM, installed by Home Manager (utm-home.nix) as
# ~/.config/i3status/config. The M3800 module list of 2016 cut to what a VM has
# (no battery, no wireless), with uppercase labels as the house style. i3bar sets
# the ground (ink) and the default text (linen) in utm-arch/i3-config; these three
# colours are for states only. utm-arch wiki/utm-theme.md.

general {
        colors = true
        color_good = "@linen@"
        color_degraded = "@rustLight@"
        color_bad = "@rustBright@"
        interval = 5
}

order += "ethernet _first_"
order += "disk /"
order += "memory"
order += "load"
order += "tztime local"

ethernet _first_ {
        format_up = "NET %ip"
        format_down = "NET DOWN"
}

disk "/" {
        format = "DISK %avail"
        low_threshold = 10
        threshold_type = "percentage_avail"
}

memory {
        format = "MEM %used"
        threshold_degraded = "20%"
        threshold_critical = "10%"
}

load {
        format = "LOAD %1min"
        max_threshold = 4
}

tztime local {
        format = "%a %d %b  %H:%M"
}
